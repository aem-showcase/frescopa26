[
  {
    "url": "https://of1--frescopa26--aem-showcase.aem.page/machines",
    "title": "Made in the workshop.",
    "blocks": [
      {
        "tag": "h1",
        "text": "Made in the workshop."
      },
      {
        "tag": "p",
        "text": "Four families of machine, each tuned by hand for a different kind of morning. Start with how you like to make it — we'll help you find the rest."
      },
      {
        "tag": "p",
        "text": "BEAN-TO-CUP · PREMIUM"
      },
      {
        "tag": "h2",
        "text": "The thinking machines"
      },
      {
        "tag": "p",
        "text": "Whole beans in, a finished cup out — milk, timing and all. The most hands-off way to drink well, and the only machines that actually learn your taste."
      },
      {
        "tag": "p",
        "text": "The Atelier learns and adapts on its own; the Mini carries the same brain to a smaller counter."
      },
      {
        "tag": "h3",
        "text": "The Atelier"
      },
      {
        "tag": "p",
        "text": "It senses what you like, builds a taste profile, reads the day ahead and pours accordingly — quietly taking care of the rest."
      },
      {
        "tag": "li",
        "text": "Learns your taste cup by cup, no dialing-in"
      },
      {
        "tag": "li",
        "text": "Reads your calendar and mood to pace the morning"
      },
      {
        "tag": "li",
        "text": "Reorders beans before you run out"
      },
      {
        "tag": "h3",
        "text": "The Atelier Mini"
      },
      {
        "tag": "p",
        "text": "The same clever heart, sized for smaller kitchens."
      },
      {
        "tag": "p",
        "text": "ESPRESSO"
      },
      {
        "tag": "h2",
        "text": "For the hands-on ritual"
      },
      {
        "tag": "p",
        "text": "Grind, tamp, pull. Machines for people who want to be the barista — precise, tactile, and built to reward practice."
      },
      {
        "tag": "p",
        "text": "The Barista gives you full manual control; the Everyday keeps it simple for a reliable shot each morning."
      },
      {
        "tag": "h3",
        "text": "The Barista"
      },
      {
        "tag": "p",
        "text": "A hands-on machine for the morning ritualist."
      },
      {
        "tag": "h3",
        "text": "The Everyday"
      },
      {
        "tag": "p",
        "text": "Honest espresso, every single morning."
      },
      {
        "tag": "p",
        "text": "FILTER"
      },
      {
        "tag": "h2",
        "text": "Slow and even"
      },
      {
        "tag": "p",
        "text": "Clean, balanced filter coffee for the unhurried cup — the kind you sip through a quiet morning."
      },
      {
        "tag": "p",
        "text": "One machine, perfected: even saturation and gentle timing, so every batch tastes the same."
      },
      {
        "tag": "h3",
        "text": "The Slow Pour"
      },
      {
        "tag": "p",
        "text": "Filter coffee, unhurried and beautifully even."
      },
      {
        "tag": "p",
        "text": "COLD BREW"
      },
      {
        "tag": "h2",
        "text": "Ready by morning"
      },
      {
        "tag": "p",
        "text": "Smooth, low-acid cold brew steeped overnight — poured cold straight from the fridge."
      },
      {
        "tag": "p",
        "text": "Set it before bed; the Carafe does the steeping while you sleep."
      },
      {
        "tag": "h3",
        "text": "The Carafe"
      },
      {
        "tag": "p",
        "text": "Smooth cold brew, ready and waiting by morning."
      },
      {
