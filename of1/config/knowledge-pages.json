  {
    "url": "https://of1--frescopa26--aem-showcase.aem.page/beverages",
    "title": "Three ways to fill a cup.",
    "blocks": [
      {
        "tag": "p",
        "text": "BEVERAGES"
      },
      {
        "tag": "h1",
        "text": "Three ways to fill a cup."
      },
      {
        "tag": "p",
        "text": "Coffee, tea, and cold-pressed juice — each sourced carefully, made in small batches, and built for a particular kind of morning. Start with what you're pouring today."
      },
      {
        "tag": "p",
        "text": "COFFEE"
      },
      {
        "tag": "h2",
        "text": "Roasted for your ritual"
      },
      {
        "tag": "p",
        "text": "House blends built for consistency, traceable single origins for the days you want to taste a place, and premium instant for when you're in a hurry. Ground, whole bean, or pods."
      },
      {
        "tag": "p",
        "text": "Worth starting with"
      },
      {
        "tag": "p",
        "text": "Morning Blend Single Origin Ethiopian Espresso Blend"
      },
      {
        "tag": "p",
        "text": "Shop all coffee→ From $10 · 10 blends"
      },
      {
        "tag": "p",
        "text": "TEA"
      },
      {
        "tag": "h2",
        "text": "A quieter kind of cup"
      },
      {
        "tag": "p",
        "text": "Eight blends across black, green and herbal, plus a small reserve of rare leaf. Loose or in bags, in three sizes — chosen for the slow afternoon hour."
      },
      {
        "tag": "p",
        "text": "Worth starting with"
      },
      {
        "tag": "p",
        "text": "English Breakfast Green Sencha Darjeeling First Flush"
      },
      {
        "tag": "p",
        "text": "Shop all tea→ From $9 · 10 blends"
      },
      {
        "tag": "p",
        "text": "COLD-PRESS JUICE"
      },
      {
        "tag": "h2",
        "text": "Bottled bright"
      },
      {
        "tag": "p",
        "text": "Cold-pressed singles and blends, plus concentrates to mix your own. No added sugar, nothing from concentrate — just fruit and veg, pressed slow and kept cold."
      },
      {
        "tag": "p",
        "text": "Worth starting with"
      },
      {
        "tag": "p",
        "text": "Orange Green Revival Beetroot & Berry"
      },
      {
        "tag": "p",
        "text": "Shop all juice→ From $5.50 · 25 pressings"
      },
      {
        "tag": "p",
        "text": "CAN'T DECIDE?"
      },
      {
        "tag": "h2",
        "text": "Taste the whole range at a café."
      },
      {
        "tag": "p",
        "text": "Sit at the bar and work through coffee, tea and juice with our team. It's the fastest way to find your everyday cup."
      },
      {
        "tag": "p",
        "text": "Find a café→"
      },
